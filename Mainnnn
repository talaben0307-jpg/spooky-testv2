-- Farm (teleport to scanned doors and press E, needs Instant Prompt)
---------------------------------------------------------------------
local farmed = setmetatable({}, { __mode = "k" })
local farmBusy = false

local function findDoorPrompt(obj)
	if obj:IsA("ProximityPrompt") then
		return obj
	end
	return obj:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function getPromptPosition(prompt)
	local parent = prompt.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position
	end
	if parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	return nil
end

local function teleportTo(position)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

local function pressE(prompt)
	if prompt and fireproximityprompt then
		pcall(fireproximityprompt, prompt)
		return
	end
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
end

local function farmDoor(obj)
	local deadline = os.clock() + FARM_TRY_TIME
	while os.clock() < deadline do
		if not settings.farmEnabled or not settings.instantPromptEnabled then
			return
		end
		if not obj.Parent or not targets[obj] then
			break
		end

		local prompt = findDoorPrompt(obj)
		local position = (prompt and getPromptPosition(prompt)) or getPosition(obj)
		if not position then
			break
		end

		teleportTo(position)
		task.wait(0.15)
		pressE(prompt)
		task.wait(0.25)
	end
	farmed[obj] = true
end

task.spawn(function()
	while true do
		task.wait(0.25)

		if not settings.farmEnabled then
			continue
		end

		if not settings.instantPromptEnabled then
			settings.farmEnabled = false
			redrawAll()
			notify("⚠ Farm stopped: Instant Prompt is off")
			continue
		end

		if farmBusy then
			continue
		end

		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then
			continue
		end

		local best, bestDist = nil, math.huge
		for obj, data in pairs(targets) do
			if data.kind == "door" and not farmed[obj] and obj.Parent then
				local remaining, elapsed = getDoorTimer(obj, data)
				local scanned = data.reader ~= nil or elapsed >= FARM_SCAN_DELAY
				local ready = scanned
				if ready and settings.farmWaitTimer and remaining then
					ready = remaining <= FARM_READY_AT
				end

				if ready then
					local position = getPosition(obj)
					local dist = position and (position - root.Position).Magnitude or math.huge
					if dist < bestDist then
						best, bestDist = obj, dist
					end
				end
			end
		end

		if best then
			farmBusy = true
			task.spawn(function()
				farmDoor(best)
				farmBusy = false
			end)
		end
	end
end)
