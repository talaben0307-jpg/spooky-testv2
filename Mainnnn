---------------------------------------------------------------------
-- Door timers (Time Door ESP + farm timing)
---------------------------------------------------------------------
local TIMER_KEYWORDS = { "time", "timer", "countdown", "expire", "lifetime", "duration", "remaining", "left", "despawn" }
local TIMER_RESCAN = 1

local function hasTimerKeyword(name)
	name = string.lower(name)
	for _, word in ipairs(TIMER_KEYWORDS) do
		if string.find(name, word, 1, true) then
			return true
		end
	end
	return false
end

local function parseTimeText(text)
	if not text or text == "" then return nil end
	local minutes, seconds = string.match(text, "(%d+):(%d+)")
	if minutes then
		return tonumber(minutes) * 60 + tonumber(seconds)
	end
	local number = string.match(text, "(%d+%.?%d*)%s*[sS][eE]?[cC]?%f[%A]")
	if number then
		return tonumber(number)
	end
	return nil
end

-- Looks inside a door for something that holds a time: an attribute, a number value or a countdown text
local function findTimerReader(obj)
	local candidates = { obj }
	for _, descendant in ipairs(obj:GetDescendants()) do
		table.insert(candidates, descendant)
	end

	for _, inst in ipairs(candidates) do
		for name, value in pairs(inst:GetAttributes()) do
			if type(value) == "number" and hasTimerKeyword(name) then
				return function()
					return inst:GetAttribute(name)
				end
			end
		end
	end

	for _, inst in ipairs(candidates) do
		if (inst:IsA("NumberValue") or inst:IsA("IntValue")) and hasTimerKeyword(inst.Name) then
			return function()
				return inst.Value
			end
		end
	end

	for _, inst in ipairs(candidates) do
		if (inst:IsA("TextLabel") or inst:IsA("TextBox")) and parseTimeText(inst.Text) then
			return function()
				return parseTimeText(inst.Text)
			end
		end
	end

	return nil
end

-- Returns remaining seconds (or nil if no timer was found) and seconds since the door was seen
local function getDoorTimer(obj, data)
	local now = os.clock()
	data.seen = data.seen or now
	local elapsed = now - data.seen

	if not data.reader and now - (data.lastScan or 0) >= TIMER_RESCAN then
		data.lastScan = now
		data.reader = findTimerReader(obj)
		data.firstRaw = nil
	end

	if not data.reader then
		return nil, elapsed
	end

	local ok, raw = pcall(data.reader)
	if not ok or type(raw) ~= "number" then
		return nil, elapsed
	end

	if raw > 1e9 then
		return math.max(raw - workspace:GetServerTimeNow(), 0), elapsed
	end

	if not data.firstRaw then
		data.firstRaw = raw
		data.firstTime = now
	end
	if raw == data.firstRaw and now - data.firstTime > 2 then
		return math.max(raw - elapsed, 0), elapsed
	end

	return math.max(raw, 0), elapsed
end

local function getTimerText(obj, data)
	local remaining, elapsed = getDoorTimer(obj, data)
	if remaining then
		if remaining <= 0 then
			return "⏱ READY"
		end
		return string.format("⏱ %.1fs", remaining)
	end
	return string.format("⏱ ? (+%ds)", math.floor(elapsed))
end

