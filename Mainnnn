local playersPage = newTab("Players", 5)
do
    local playerSettings = {
        Highlights = false,
        NameTags = false,
        ShowHealth = false,
        TeamColors = false,
    }

    local PLAYER_OPTIONS = {
        { key = "Highlights", text = "Player Highlights" },
        { key = "NameTags", text = "Name Tags" },
        { key = "ShowHealth", text = "Show Health" },
        { key = "TeamColors", text = "Team Colors" },
    }

    local function updatePlayerVisuals()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local char = plr.Character
                
                -- 1. Highlight Handling
                local highlight = char:FindFirstChild("PlayerESPHighlight")
                if playerSettings.Highlights then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "PlayerESPHighlight"
                        highlight.Adornee = char
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.Parent = char
                    end
                    highlight.Enabled = true
                    if playerSettings.TeamColors and plr.Team then
                        highlight.FillColor = plr.Team.TeamColor.Color
                        highlight.OutlineColor = plr.Team.TeamColor.Color
                    else
                        highlight.FillColor = Color3.fromRGB(60, 140, 255)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    end
                elseif highlight then
                    highlight.Enabled = false
                end

                -- 2. NameTag & Health BillboardGui Handling
                local head = char:FindFirstChild("Head")
                local billboard = char:FindFirstChild("PlayerESPBillboard")
                
                if (playerSettings.NameTags or playerSettings.ShowHealth) and head then
                    if not billboard then
                        billboard = Instance.new("BillboardGui")
                        billboard.Name = "PlayerESPBillboard"
                        billboard.Size = UDim2.fromOffset(150, 40)
                        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                        billboard.AlwaysOnTop = true
                        billboard.Adornee = head
                        billboard.Parent = char

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "InfoText"
                        textLabel.Size = UDim2.fromScale(1, 1)
                        textLabel.BackgroundTransparency = 1
                        textLabel.TextStrokeTransparency = 0.3
                        styleText(textLabel, 13)
                        textLabel.Parent = billboard
                    end
                    
                    billboard.Enabled = true
                    local textLabel = billboard:FindFirstChild("InfoText")
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    
                    if textLabel and humanoid then
                        local textParts = {}
                        if playerSettings.NameTags then
                            table.insert(textParts, plr.Name)
                        end
                        if playerSettings.ShowHealth then
                            table.insert(textParts, "❤ " .. math.floor(humanoid.Health))
                        end
                        textLabel.Text = table.concat(textParts, " ")
                    end
                elseif billboard then
                    billboard.Enabled = false
                end
            end
        end
    end

    for _, option in ipairs(PLAYER_OPTIONS) do
        local row = newRow(playersPage, option.text)
        local button = newButton(row, 70)
        
        local function refreshButton()
            local active = playerSettings[option.key]
            button.Text = active and "ON" or "OFF"
            button.BackgroundColor3 = active and GREEN or RED
        end

        button.MouseButton1Click:Connect(function()
            playerSettings[option.key] = not playerSettings[option.key]
            refreshButton()
            updatePlayerVisuals()
        end)
        
        refreshButton()
    end

    newInfo(playersPage, "ℹ Funktioniert lokal im Testmodus / Offline-Spiel.")

    -- Regelmäßiges Aktualisieren der Spieler-Visuals im RenderStepped oder via Schleife
    RunService.RenderStepped:Connect(function()
        if playerSettings.Highlights or playerSettings.NameTags or playerSettings.ShowHealth then
            updatePlayerVisuals()
        end
    end)
end

