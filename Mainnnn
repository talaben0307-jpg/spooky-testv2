-- guard (optional): called before turning ON, returns ok, message
local function newToggle(page, text, key, guard)
	local button = newButton(newRow(page, text), 70)
	local function update()
		button.Text = settings[key] and "ON" or "OFF"
		button.BackgroundColor3 = settings[key] and GREEN or RED
	end
	button.MouseButton1Click:Connect(function()
		local newValue = not settings[key]
		if newValue and guard then
			local ok, message = guard()
			if not ok then
				if message then
					notify(message)
				end
				return
			end
		end
		settings[key] = newValue
		update()
		refresh()
	end)
	update()
	table.insert(updaters, update)
end

local function newCycle(page, text, getText, nextValue)
	local button = newButton(newRow(page, text), 120)
	local function update()
		button.Text = getText() .. "  ▶"
	end
	button.MouseButton1Click:Connect(function()
		nextValue()
		update()
		refresh()
	end)
	update()
	table.insert(updaters, update)
end

local function newColorPicker(page, text, key)
	newCycle(page, text, function()
		return COLORS[settings[key]].name
	end, function()
		settings[key] = settings[key] % #COLORS + 1
	end)
end

-- One option of a group: only one option of the group can be active
local function newOption(page, text, key, value, onSelect)
	local button = newButton(newRow(page, text), 90)
	local function update()
		local active = settings[key] == value
		button.Text = active and "ACTIVE" or "USE"
		button.BackgroundColor3 = active and GREEN or NEUTRAL
	end
	button.MouseButton1Click:Connect(function()
		if settings[key] == value then return end
		settings[key] = value
		redrawAll()
		refresh()
		if onSelect then onSelect() end
	end)
	update()
	table.insert(updaters, update)
end

